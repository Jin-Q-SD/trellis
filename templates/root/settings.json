{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent/tools/scripts/scan.py\" \"$CLAUDE_PROJECT_DIR\" --brief"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent/tools/scripts/scan.py\" \"$CLAUDE_PROJECT_DIR\" --brief --after-compact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent/tools/scripts/guard_delete.py\""
          }
        ]
      }
    ]
  }
}
